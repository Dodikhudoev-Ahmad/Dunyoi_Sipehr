# Base URL of the AeroTravel backend API (see docs/BLOCKERS.md BLK-003).
# Defaults to http://localhost:5091/api/v1 when unset (matches backend/Api/Properties/launchSettings.json).
VITE_API_BASE_URL=http://localhost:5091/api/v1

# Canonical production site origin (no trailing slash) — used for sitemap.xml generation,
# canonical/OG/Twitter URLs, and Organization JSON-LD. Defaults to the current Vercel deployment
# URL when unset; update once a custom domain is live (see docs/BLOCKERS.md BLK-006).
VITE_SITE_URL=https://dunyoi-sipehr.vercel.app
